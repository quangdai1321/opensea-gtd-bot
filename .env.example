# Chep file nay thanh .env roi dien gia tri CUA BAN. KHONG commit .env, KHONG gui cho ai.

# Bot Telegram rieng cua ban: chat voi @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Nhan 1 tin cho bot, roi chay: node notify.mjs chatid
TELEGRAM_CHAT_ID=
# 1 = gui kem cau tra loi cuoi cua agent (notify.mjs), 0 = chi bao "xong viec"
TELEGRAM_SEND_TEXT=1

# OpenSea API key: https://opensea.io/settings/developer
OPENSEA_API_KEY=

# Vi can theo doi GTD / WL (drops.mjs tren GitHub Actions)
WATCH_WALLET=

# Tuy chon: token dang nhap OpenSea de biet vi co GTD/WL TRUOC gio mo.
# opensea.io (dang nhap) -> F12 -> Application -> Cookies -> https://opensea.io -> access_token
# Het han ~1 ngay. Cho phep thao tac tai khoan OpenSea cua ban -> giu kin.
OPENSEA_JWT=

# Tuy chon: RPC rieng (nhanh hon, it bi gioi han), cach nhau dau phay
# RPC_ROBINHOOD=https://...
# RPC_BASE=https://...

# Tuy chon khac
# MINT_LEAD_SECONDS=60      bat dau chay truoc gio mo bao nhieu giay
# BURST_BEFORE_MS=120       burst: ban phat dau tien som hon gio mo bao nhieu ms
# BURST_SPACING_MS=90       burst: cach nhau bao nhieu ms giua cac phat
#                           dat xap xi 1 block cua chain do - xem "node recon.mjs <chain> <nft>"
# REMIND_MINUTES=60         nhac truoc gio mo bao nhieu phut
# ELIG_POLL_MINUTES=5       kiem tra quyen GTD/WL moi bao nhieu phut
# PRICE_POLL_MINUTES=2      kiem tra gia moi bao nhieu phut
# MINT_PASSWORD=            dat de bot tu chay khong hoi mat khau (KEM AN TOAN)

# Tuy chon: vi nhan khi /withdraw, /withdrawnft (mac dinh la vi chinh). Chi sua duoc o day, khong qua Telegram.
# WITHDRAW_TO=0x...
