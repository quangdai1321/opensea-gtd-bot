# Doi ten file nay thanh .env roi dien vao

# --- Chon chain ---
# Preset co san: ethereum, base, arbitrum, optimism, polygon, bsc,
#                avalanche, zksync, blast, scroll, linea, robinhood
CHAIN=robinhood

# Hoac dien tay (uu tien hon preset). Tra chain ID tai https://chainlist.org
# CHAIN_ID=8453
# RPC_URL=https://mainnet.base.org
# EXPLORER=https://basescan.org/tx/

# --- Che do mint ---
# seadrop  : goi thang contract SeaDrop cua OpenSea. Doc gia + gioi han tu contract.
#            CHINH XAC HON, chi can NFT_CONTRACT. Dung cho drop cua OpenSea.
# calldata : replay calldata da copy tu explorer. Dung khi khong phai SeaDrop.
MINT_MODE=seadrop

# --- Che do seadrop ---
# Dia chi contract NFT (KHONG phai dia chi SeaDrop). Lay tu URL OpenSea hoac explorer.
NFT_CONTRACT=0x...

# So luong muon mint moi vi. Script tu ha xuong neu vuot gioi han.
SEADROP_QUANTITY=5

# true = cho den gio mo mint roi ban. false = chua mo thi thoat.
WAIT_FOR_OPEN=false
SEADROP_POLL_MS=5000

# Chi sua neu chain dung dia chi khac voi mac dinh cua OpenSea
# SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5
# SEADROP_FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719

# --- Che do calldata (bo qua neu dung seadrop) ---
# Private key cua vi mint (KHONG dung vi chinh - tao vi phu rieng cho viec nay)
PRIVATE_KEY=0x...

# Dia chi contract - lay tu truong "To" cua giao dich mint thu cong tren explorer
CONTRACT=0x...

# Raw input / calldata - lay tu tab "Raw input" cua giao dich mint thu cong
CALLDATA=0x...

# So coin native gui kem moi giao dich - lay tu truong "Value"
VALUE_ETH=0.0001

# Dia chi cua vi DA MINT TAY de lay calldata.
# Neu calldata ghi cung dia chi nguoi nhan, script se tu doi sang vi dang chay.
# Chay "node inspect.js" truoc de biet co can dien hay khong.
ORIGINAL_MINTER=0x...

# --- Tuy chon ---
# Neu mint tra bang ERC20 (USDC, WETH...) thi dien dia chi token vao day
# va de VALUE_ETH=0. Script se tu approve truoc khi mint.
# PAY_TOKEN=0x...

# So lan lap moi vi
LOOPS=5

# --- Chay nhieu vi (run-all.js) ---
# Duong dan TUONG DOI de dung chung duoc ca Linux lan Windows.
# Dung dat duong dan tuyet doi kieu /run/media/... hoac D:\\... vao day.
WALLETS_DIR=./wallets

# Mat khau keystore. De TRONG de script hoi moi lan chay (an toan hon).
# KEYSTORE_PASSWORD=

# Nghi ngau nhien giua CAC VI (ms). Tong = DELAY + random(0..JITTER)
WALLET_DELAY_MS=5000
WALLET_JITTER_MS=10000

# Jitter giua cac giao dich trong cung 1 vi
JITTER_MS=3000

# Nghi bao nhieu ms giua cac lan (tranh bi rate limit RPC)
DELAY_MS=2000

# true = ban lien tuc khong doi confirm (nhanh hon, rui ro nonce cao hon)
FAST=false

# true = chi mo phong, khong gui giao dich that. Chay lan dau nen de true.
DRY_RUN=true
